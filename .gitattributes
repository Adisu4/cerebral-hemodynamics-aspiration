# Keep project source and metadata consistently LF-normalized.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.txt text eol=lf

# Saved run reports are machine-generated regression fixtures.
reference_results/reports/*.json linguist-generated=true
reference_results/study_manifest.json linguist-generated=true

# Preserve byte-for-byte provenance snapshots on every operating system.
frozen_reference/*.py -text
